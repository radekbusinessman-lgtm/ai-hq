# Zkopírujte do souboru .env a doplňte skutečné hodnoty.
# Soubor .env se NIKDY necommituje do Gitu.

# --- Prostředí ---
APP_ENV=development            # development | production

# --- Databáze (Supabase Frankfurt; lokálně Docker) ---
DATABASE_URL=postgresql+psycopg://aihq:aihq_dev@localhost:5432/aihq

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_OWNER_USER_ID=         # jediný uživatel, kterého bot poslouchá

# --- AI ---
ANTHROPIC_API_KEY=
LLM_MODEL_DEFAULT=claude-sonnet-5-5
LLM_MODEL_BRIEFING=claude-opus-5-5
VOYAGE_API_KEY=                # embeddingy pro vyhledávání v dokumentech
ANTHROPIC_KEY_EXPIRES_ON=      # datum vypršení klíče, např. 2027-02-04 (upozornění 14 dní předem)

# --- Limity ---
MONTHLY_BUDGET_USD=50
BUDGET_WARNING_PCT=80
MAX_TOOL_STEPS_PER_RUN=10
MAX_RUN_SECONDS=120
MAX_RUN_COST_USD=1.0

# --- Úložiště dokumentů ---
DOCUMENTS_DIR=./data/documents
