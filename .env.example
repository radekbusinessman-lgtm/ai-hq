# AI HQ – konfigurace. Soubor .env se NIKDY necommituje do Gitu ani nikam neposílá.
# Hodnoty vkládejte hned za rovnítko, bez mezer a bez uvozovek.

APP_ENV=production

# --- Databáze: Supabase → Connect → Direct → Session pooler ---
# Začátek postgresql:// se při spuštění sám změní na postgresql+psycopg://
DATABASE_URL=

# --- Discord ---
DISCORD_BOT_TOKEN=
# ID serveru AI HQ (pravý klik na ikonu serveru → Kopírovat ID serveru)
DISCORD_GUILD_ID=
# Vaše ID (pravý klik na své jméno → Kopírovat ID uživatele)
DISCORD_OWNER_USER_ID=

# --- AI ---
ANTHROPIC_API_KEY=
# Datum vypršení klíče ve tvaru RRRR-MM-DD, např. 2027-02-04
ANTHROPIC_KEY_EXPIRES_ON=
LLM_MODEL_DEFAULT=claude-sonnet-5-5
LLM_MODEL_BRIEFING=claude-opus-5-5
# Embeddingy pro vyhledávání v dokumentech (doplníme později)
VOYAGE_API_KEY=

# --- Limity ---
MONTHLY_BUDGET_USD=50
BUDGET_WARNING_PCT=80
MAX_TOOL_STEPS_PER_RUN=10
MAX_RUN_SECONDS=120
MAX_RUN_COST_USD=1.0

# --- Úložiště dokumentů ---
DOCUMENTS_DIR=./data/documents
